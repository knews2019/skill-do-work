+// TestLegacyPriorityScaleRaisesNoWarning is the priority half of the same
+// silence guarantee. Before now/next/later existed, the do-validate-feedback REQs
+// of UR-011..UR-015 ranked this queue with a finding's severity grade, and the
+// fourteen archived records still carrying `priority: P2`/`P3`/`P4` each spent a
+// permanent data warning on a field no completed REQ is ever read for — fourteen
+// lines of noise in front of the one warning that would matter. The P-scale is a
+// read-only legacy alias now, and this is where those records are proved to
+// resolve quietly through buildBoard, the seam a real board read goes through.
+func TestLegacyPriorityScaleRaisesNoWarning(t *testing.T) {
+	repoRoot := t.TempDir()
+	queueDir := filepath.Join(repoRoot, "do-work", "queue")
+	if mkdirError := os.MkdirAll(queueDir, 0o755); mkdirError != nil {
+		t.Fatalf("mkdir: %v", mkdirError)
+	}
+	for _, fixture := range []struct {
+		fileName        string
+		requestId       string
+		frontmatterLine string
+		wantPriority    string
+	}{
+		{"REQ-0121-p0.md", "REQ-0121", "priority: P0\n", requestPriorityNow},
+		{"REQ-0122-p1.md", "REQ-0122", "priority: P1\n", requestPriorityNow},
+		{"REQ-0123-p2.md", "REQ-0123", "priority: P2\n", requestPriorityNext},
+		{"REQ-0124-p3.md", "REQ-0124", "priority: P3\n", requestPriorityLater},
+		{"REQ-0125-p4.md", "REQ-0125", "priority: P4\n", requestPriorityLater},
+	} {
+		reqFileContent := "---\nid: " + fixture.requestId +
+			"\ntitle: Fixture\nstatus: pending\n" + fixture.frontmatterLine + "---\nbody\n"
+		if writeError := os.WriteFile(filepath.Join(queueDir, fixture.fileName), []byte(reqFileContent), 0o644); writeError != nil {
+			t.Fatalf("write fixture %s: %v", fixture.fileName, writeError)
+		}
+	}
+
+	board, buildError := buildBoard(repoRoot, time.Now(), 7*24*time.Hour, nil)
+	if buildError != nil {
+		t.Fatalf("buildBoard: %v", buildError)
+	}
+	for _, warningText := range board.Warnings {
+		if strings.Contains(warningText, "priority") {
+			t.Errorf("unexpected priority warning for a legacy P-scale value: %q", warningText)
+		}
+	}
+	for requestId, wantPriority := range map[string]string{
+		"REQ-0121": requestPriorityNow,
+		"REQ-0122": requestPriorityNow,
+		"REQ-0123": requestPriorityNext,
+		"REQ-0124": requestPriorityLater,
+		"REQ-0125": requestPriorityLater,
+	} {
+		ticket := board.RequestsById[requestId]
+		if ticket == nil {
+			t.Fatalf("%s not parsed", requestId)
+		}
+		if ticket.Priority != wantPriority || ticket.PriorityUnrecognized {
+			t.Errorf("%s: Priority = %q, PriorityUnrecognized = %v — want %q, false — "+
+				"the legacy P-scale must still resolve, or every archived REQ predating "+
+				"now/next/later warns forever",
+				requestId, ticket.Priority, ticket.PriorityUnrecognized, wantPriority)
+		}
+	}
+}
