+// A fixed board for the trailing-window and landing probes. Both used to build
+// their board from this repository's own queue with the wall clock as now, and
+// the assertions' preconditions (a range reaching now, thirty days of history,
+// a step past the data) then held only while something in the queue was open —
+// a drained checkout failed them a few days after its last completion. This
+// payload pins every instant the two cases read: a completed REQ at the start of
+// the range, a REQ still running at the end, and a now the range reaches.
+//
+// Three of its numbers are load-bearing, and a guard in one of the probes fires
+// if any of them moves:
+//   - rangeStart is more than thirty days before now (91.5 days here), or the
+//     30-day chip would be clipped and the trailing probe's span guard fails;
+//   - the 2% bound padding (1.83 days here) is narrower than the seven-day
+//     screenful, so the step forward from Last 7 days is a refused partial step
+//     and the landing probe's clause (3) is pinned to its refusal branch;
+//   - projection.queueEnd stays empty, or renderTimelineView would extend the
+//     bound past now and the trailing anchor would no longer be now.
+const timelineFixedFixturePayloadScript = `
+  var payload = window.queueKanbanBoardData;
+  payload.requests["REQ-FIXED-DONE"] = {
+    id: "REQ-FIXED-DONE",
+    title: "Completed at the start of the fixed range",
+    status: "completed",
+    domain: "backend",
+    route: "A",
+    userRequestId: ""
+  };
+  payload.requests["REQ-FIXED-OPEN"] = {
+    id: "REQ-FIXED-OPEN",
+    title: "Still running at the fixed now",
+    status: "claimed",
+    domain: "frontend",
+    route: "A",
+    userRequestId: ""
+  };
+  payload.timeline = {
+    rows: [{
+      id: "REQ-FIXED-OPEN",
+      createdTime: "2026-08-20T00:00:00Z",
+      claimedTime: "2026-08-21T00:00:00Z",
+      completedTime: "",
+      waitMinutes: 1440,
+      waitOpen: false,
+      hasWork: true,
+      workMinutes: 15120,
+      workOpen: true
+    }, {
+      id: "REQ-FIXED-DONE",
+      createdTime: "2026-06-01T00:00:00Z",
+      claimedTime: "2026-06-02T00:00:00Z",
+      completedTime: "2026-06-03T00:00:00Z",
+      waitMinutes: 1440,
+      waitOpen: false,
+      hasWork: true,
+      workMinutes: 1440,
+      workOpen: false
+    }],
+    rangeStart: "2026-06-01T00:00:00Z",
+    rangeEnd: "2026-08-31T12:00:00Z",
+    now: "2026-08-31T12:00:00Z",
+    projection: {
+      rows: [], excluded: [], queueEnd: "", chainStart: "",
+      windowSize: 0, windowSamples: 0, trivialSamples: 0, normalSamples: 0,
+      trivialMinutes: 0, normalMinutes: 0, minimumSamples: 0,
+      confident: false, declinedReason: "No pending work."
+    }
+  };
+`
