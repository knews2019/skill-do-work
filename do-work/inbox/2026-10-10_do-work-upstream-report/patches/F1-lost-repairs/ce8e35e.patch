@@ -2259,35 +2281,90 @@ window.addEventListener("load", function () {` + timelineFixedFixturePayloadScri
 	// (3) A step past everything drawn does not happen, and says so first.
 	//
 	// A trailing window ends at now, so the screenful after it is entirely in the
-	// future. Which regime that puts the arrow in depends on the payload: with no
-	// forecast past now that screenful is only the cosmetic bound padding and the
