-		}
+	// future, and on the fixed payload that screenful is only the cosmetic bound
+	// padding, so the arrow must refuse. That regime is PINNED by
+	// timelineFixedFixturePayloadScript rather than read off the live queue —
+	// asserting a regime against the live queue is what made capturing three REQs
+	// fail this test (REQ-174). Because it is pinned, the refusal is asserted
+	// outright instead of being one arm of a conditional: a conditional whose other
+	// arm this board can never reach is not coverage, it is a branch that reports
+	// success for a button that never worked (REQ-177). The successful step is
+	// exercised for real in (3b) below, and the refusal a second time under a
+	// filter in (6).
+	if !landingResult.TrailingSevenDays.Disabled["timeline-period-next"] {
+		t.Errorf("the step-forward arrow was enabled on the last seven days (%s), but the fixed "+
+			"payload puts only the cosmetic bound padding past now — it has no forecast to step onto",
+			landingResult.TrailingSevenDays.Readout)
+	}
+	if landingResult.AfterStepFromTrailingSevenDays.Readout != landingResult.TrailingSevenDays.Readout {
+		t.Errorf("the step-forward arrow reported itself disabled on the last seven days (%s) "+
+			"and the press moved the window to %s anyway", landingResult.TrailingSevenDays.Readout,
+			landingResult.AfterStepFromTrailingSevenDays.Readout)
+	}
+
+	// (3b) A step that CAN happen does happen, moves exactly one screenful, and
+	// comes back.
+	//
+	// The refusal above proves the arrows say no when they should. It cannot prove
+	// they ever say yes: two permanently disabled buttons satisfy every assertion
+	// in (3) and (6), and did — both strict suites passed with the availability
+	// expression forced to false. So the enabled half is asserted here on presses
+	// that must succeed. Previous from the trailing window lands on the seven days
+	// before it, which the fixed payload fills with the open row; Next is its
+	// inverse and must return to the exact window it started from. Endpoints are
+	// compared as instants, not as readout text, so a step that moved by the wrong
+	// amount cannot pass by rendering the same string.
+	const sevenDaysMs = 7 * 24 * 60 * 60 * 1000
+	trailingStartMs := *landingResult.TrailingSevenDays.StartMs
+	trailingEndMs := *landingResult.TrailingSevenDays.EndMs
+
+	if landingResult.TrailingSevenDays.Disabled["timeline-period-prev"] {
+		t.Fatalf("the step-back arrow reported itself disabled on the last seven days (%s), so the "+
+			"successful-step assertions below have nothing to press; the fixed payload has %.0f days "+
+			"of range before that window", landingResult.TrailingSevenDays.Readout,
+			(trailingStartMs-*landingResult.AllDays.StartMs)/(24*60*60*1000))
+	}
+	if wantStartMs := trailingStartMs - sevenDaysMs; *landingResult.AfterPrevFromTrailingSevenDays.StartMs != wantStartMs {
+		t.Errorf("stepping back from the last seven days (%s) started the window at %s, want %s — "+
+			"one screenful earlier", landingResult.TrailingSevenDays.Readout,
+			timelineProbeInstant(*landingResult.AfterPrevFromTrailingSevenDays.StartMs),
+			timelineProbeInstant(wantStartMs))
+	}
+	if wantEndMs := trailingEndMs - sevenDaysMs; *landingResult.AfterPrevFromTrailingSevenDays.EndMs != wantEndMs {
+		t.Errorf("stepping back from the last seven days (%s) ended the window at %s, want %s — "+
+			"one screenful earlier", landingResult.TrailingSevenDays.Readout,
+			timelineProbeInstant(*landingResult.AfterPrevFromTrailingSevenDays.EndMs),
+			timelineProbeInstant(wantEndMs))
+	}
+	if *landingResult.AfterPrevFromTrailingSevenDays.SpanMs != *landingResult.TrailingSevenDays.SpanMs {
+		t.Errorf("stepping back changed the window's WIDTH from %.2f to %.2f days — a step walks the "+
+			"window, it does not resize it",
+			*landingResult.TrailingSevenDays.SpanMs/(24*60*60*1000),
+			*landingResult.AfterPrevFromTrailingSevenDays.SpanMs/(24*60*60*1000))
+	}
+	if landingResult.AfterPrevFromTrailingSevenDays.DrawnSegments == 0 {
+		t.Errorf("stepping back from the last seven days landed on %s with nothing drawn in it — the "+
+			"fixed payload's open row spans that window, so an empty chart means the step went "+
+			"somewhere else", landingResult.AfterPrevFromTrailingSevenDays.Readout)
+	}
+
+	if landingResult.AfterPrevFromTrailingSevenDays.Disabled["timeline-period-next"] {
+		t.Fatalf("the step-forward arrow reported itself disabled at %s, one screenful before the "+
+			"trailing window it just came from — a step back must always leave a step forward "+
+			"available", landingResult.AfterPrevFromTrailingSevenDays.Readout)
+	}
+	if *landingResult.AfterNextBackToTrailingSevenDays.StartMs != trailingStartMs ||
+		*landingResult.AfterNextBackToTrailingSevenDays.EndMs != trailingEndMs {
+		t.Errorf("back and forward did not return to the window they started from: %s → %s → %s",
+			landingResult.TrailingSevenDays.Readout,
+			landingResult.AfterPrevFromTrailingSevenDays.Readout,
+			landingResult.AfterNextBackToTrailingSevenDays.Readout)
+	}
+	if landingResult.AfterNextBackToTrailingSevenDays.DrawnSegments == 0 {
+		t.Errorf("stepping forward returned to %s with nothing drawn in it, though the same window "+
+			"drew %d segments a moment earlier",
+			landingResult.AfterNextBackToTrailingSevenDays.Readout,
+			landingResult.TrailingSevenDays.DrawnSegments)
 	}
 
