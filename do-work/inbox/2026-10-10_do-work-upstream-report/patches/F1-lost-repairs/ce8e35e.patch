+//
+// timelineProbeInstant renders a probe's epoch-millisecond window endpoint the way
+// the board's own range readout does, so a failure message names an instant the
+// reader can match against the page instead of a bare millisecond count.
+func timelineProbeInstant(epochMilliseconds float64) string {
+	return time.UnixMilli(int64(epochMilliseconds)).UTC().Format("2006-01-02 15:04") + " UTC"
+}
