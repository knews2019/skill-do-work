+<div class="deck-hint" aria-live="polite" id="deck-hint">Deck mode</div>
+<script src="../../ai-report-kit/presentation.js"></script>
+<script>
+  const inspectHour = document.getElementById("inspect-hour");
+  const visitorRows = document.getElementById("visitor-data").rows;
+  const seriesReadings = document.querySelectorAll(".series-reading");
+
+  function showHeadcount() {
+    const hourIndex = inspectHour.selectedIndex;
+    const [time, ...counts] = [...visitorRows[hourIndex].cells].map(cell => cell.textContent);
+    const total = counts.pop();
+    document.getElementById("hour-total").textContent = `${time} · ${total} visitors across all activities`;
+    seriesReadings.forEach((reading, index) => {
+      reading.textContent = `Selected ${counts[index]} at ${time}`;
+      reading.hidden = false;
+    });
+    document.querySelectorAll(".time-marker").forEach(marker => {
+      marker.style.setProperty("--selected-time", `${100 * hourIndex / (visitorRows.length - 1)}%`);
+      marker.hidden = false;
+    });
+    document.querySelectorAll(".time-axis").forEach(axis => {
+      [...axis.children].forEach((label, index) => label.classList.toggle("is-current", index === hourIndex));
+    });
+  }
+
+  showHeadcount();
+  inspectHour.addEventListener("change", showHeadcount);
+  document.getElementById("hour-inspector").hidden = false;
+  document.getElementById("deck-toggle").hidden = false;
+</script>
+</body>
