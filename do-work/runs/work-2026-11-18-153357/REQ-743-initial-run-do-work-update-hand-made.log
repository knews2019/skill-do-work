+  .rhythm-key { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0 0 16px; padding: 0; list-style: none; font-size: .86rem; }
+  .rhythm-key li { display: flex; align-items: center; gap: 7px; }
+  .series-swatch { flex: 0 0 14px; height: 14px; border-radius: 4px; background: var(--series); }
+  .view-controls { display: flex; flex-wrap: wrap; gap: 4px 18px; margin: 0 0 14px; padding: 0; border: 0; }
+  .view-controls legend { padding: 0; font-size: .88rem; font-weight: 700; }
+  .view-controls label { display: inline-flex; gap: 6px; min-height: 44px; align-items: center; cursor: pointer; }
+  .view-controls input { margin: 0; accent-color: var(--change); }
+  .overview-card:not(:has(#separate-lines:checked)) .overview-lines,
+  .overview-card:has(#separate-lines:checked) .overview-bands { display: none; }
+  .rhythm-frame { display: grid; grid-template-columns: 2.15rem minmax(0, 1fr); gap: 6px 8px; margin-top: 8px; }
+  .rhythm-scale { display: flex; flex-direction: column; justify-content: space-between; text-align: right; }
+  .rhythm-scale span { line-height: 1; }
+  .rhythm-scale span:first-child { translate: 0 -50%; }
+  .rhythm-scale span:last-child { translate: 0 50%; }
+  .rhythm-scale, .time-axis { color: var(--muted); font-size: .78rem; font-variant-numeric: tabular-nums; }
+  .rhythm-plot { position: relative; height: 76px; margin-inline: 12px; }
+  .overview-card .rhythm-plot { height: clamp(160px, 24vw, 278px); }
+  .rhythm-plot svg { display: block; width: 100%; height: 100%; overflow: visible; }
+  .grid-lines { stroke: var(--line); stroke-width: 1; fill: none; vector-effect: non-scaling-stroke; }
+  .series-band { fill: var(--series); stroke: var(--surface); stroke-width: 1; vector-effect: non-scaling-stroke; }
+  .series-area { fill: color-mix(in srgb, var(--series) 22%, var(--surface)); }
+  .series-line { fill: none; stroke: var(--series); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
+  .overview-lines .computer-series, .overview-lines .group-series { stroke-dasharray: 6 4; }
+  .overview-lines .help-series, .overview-lines .browsing-series { stroke-dasharray: 2 4; }
+  .time-marker { position: absolute; inset-block: 0; inset-inline-start: var(--selected-time); border-inline-start: 2px dashed var(--ink); pointer-events: none; }
+  .peak-marker { position: absolute; inset-inline-start: var(--peak-x); inset-block-start: var(--peak-y); width: 10px; height: 10px; translate: -50% -50%; border: 2px solid var(--ink); border-radius: 50%; background: var(--surface); }
+  .time-axis { grid-column: 2; display: flex; justify-content: space-between; margin: 0 12px; padding: 0; list-style: none; }
+  .time-axis li { width: 0; display: flex; justify-content: center; white-space: nowrap; }
+  .time-axis .is-current { color: var(--ink); font-weight: 750; text-decoration: underline; text-underline-offset: .2em; }
+  .series-list { display: grid; gap: 10px; }
+  .series-heading { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 14px; margin-bottom: 10px; }
+  .series-heading h3, .series-heading p { margin: 0; }
+  .series-reading { color: var(--muted); font-size: .86rem; }
+  .hour-inspector:not([hidden]) { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; margin: 16px 0 0; }
+  .hour-inspector select { min-height: 44px; padding-inline: 8px; color: var(--ink); background: var(--surface); border: 1px solid var(--muted); border-radius: 8px; font: inherit; }
+  .hour-inspector output { font-size: .92rem; }
+  .view-controls input:focus-visible, .hour-inspector select:focus-visible, .data-disclosure summary:focus-visible, .table-scroll:focus-visible { outline: 3px solid var(--change); outline-offset: 3px; }
+  .data-disclosure { margin-top: 20px; }
+  .table-scroll { overflow-x: auto; margin-bottom: 12px; }
+  .data-table { width: 100%; border-collapse: collapse; font-size: .82rem; font-variant-numeric: tabular-nums; }
+  .data-table caption { color: var(--muted); text-align: left; padding-bottom: 8px; }
+  .data-table th, .data-table td { text-align: start; border-bottom: 1px solid var(--line); padding: 6px; }
+  .data-table tbody th { white-space: nowrap; }
+  @media (max-width: 480px) { .time-minutes { display: none; } }
+</style>
+</head>
+<body>
