+	"time"
+	"unicode"
+
+	"github.com/knews2019/skill-do-work/do-work-cli/internal/commandruntime"
+	"github.com/knews2019/skill-do-work/do-work-cli/internal/requestmodel"
+	"github.com/knews2019/skill-do-work/do-work-cli/internal/resultmodel"
+	"github.com/knews2019/skill-do-work/do-work-cli/internal/rootedfs"
+)
+
+const (
+	reportGalleryFolder   = "docs/report-gallery"
+	reportGalleryPageFile = reportGalleryFolder + "/index.html"
+	reportGalleryRecord   = "sample.md"
+	reportGalleryExample  = "example.html"
+)
+
+var (
+	reportGalleryNamePattern = regexp.MustCompile(`^[a-z0-9]+(?:-[a-z0-9]+)+$`)
+	errHandMadeGallery       = errors.New("missing the ai-report-gallery generator header")
+)
+
+type reportGallerySample struct {
+	Name       string
+	RecordPath string
+	Title      string
+	UseWhen    string
+	Source     string
+	Image      string
+	Borrow     []string
+}
+
+func handleAIReportGallery(ctx commandruntime.ExecutionContext, args []string) resultmodel.CommandResult {
+	listOnly := len(args) == 1 && args[0] == "--list"
+	if len(args) != 0 && !listOnly {
+		return usageResult(CommandAIReportGallery, "Usage: ai-report-gallery [--list]")
+	}
+	repository, err := os.OpenRoot(ctx.RepositoryRoot)
+	if err != nil {
+		return reportGalleryFailure(".", err)
+	}
+	defer repository.Close()
+
+	// Reject linked output parents before discovery. The publisher also confines the final write.
+	if !listOnly {
+		if err := validateNoLinkedAncestors(ctx.RepositoryRoot, reportGalleryPageFile, false); err != nil {
+			return reportGalleryRefusal(err)
+		}
+	}
+	toolboxDocs, err := reportGalleryToolboxDocs(repository)
+	if err != nil {
+		return reportGalleryFailure("do-work-toolbox/docs", err)
+	}
+	var shippedFolder string
+	if toolboxDocs != "" {
+		shippedFolder = path.Join(toolboxDocs, "report-gallery")
+	}
+	samples, findings, err := discoverReportGallerySamples(repository, shippedFolder)
+	if err != nil {
+		return reportGalleryFailure(reportGalleryFolder, err)
+	}
+
+	var result resultmodel.CommandResult
+	if listOnly {
+		var output strings.Builder
+		for _, sample := range samples {
+			fmt.Fprintf(&output, "%s\t%s\t%s\n", sample.Name, sample.UseWhen, sample.RecordPath)
+		}
+		result = exactOutputResult(output.String(), nil)
+	} else {
+		result = writeReportGallery(ctx.RepositoryRoot, repository, toolboxDocs, samples)
+	}
+	result.Findings = append(result.Findings, findings...)
+	return result
+}
+
+// Installed files take precedence when a project also contains a suite checkout.
+func reportGalleryToolboxDocs(repository *os.Root) (string, error) {
+	for _, candidate := range []string{".claude/skills/do-work-toolbox/docs", "skills/do-work-toolbox/docs"} {
+		info, err := repository.Lstat(filepath.FromSlash(candidate))
+		if errors.Is(err, fs.ErrNotExist) {
+			continue
+		}
+		if err != nil {
+			return "", err
+		}
+		if !info.IsDir() {
+			return "", fmt.Errorf("%s must be a directory", candidate)
+		}
+		return candidate, nil
+	}
+	return "", nil
+}
+
+func discoverReportGallerySamples(repository *os.Root, shippedFolder string) ([]reportGallerySample, []resultmodel.CommandFinding, error) {
+	byName := map[string]reportGallerySample{}
+	var findings []resultmodel.CommandFinding
+	for _, folder := range []string{shippedFolder, reportGalleryFolder} {
+		if folder == "" {
+			continue
+		}
+		entries, err := fs.ReadDir(repository.FS(), folder)
+		if errors.Is(err, fs.ErrNotExist) {
+			continue
+		}
+		if err != nil {
+			return nil, findings, err
+		}
+		for _, entry := range entries {
+			name := entry.Name()
+			if !entry.IsDir() || !reportGalleryNamePattern.MatchString(name) {
+				continue
+			}
+			record := path.Join(folder, name, reportGalleryRecord)
+			sample, err := readReportGallerySample(repository, name, record)
+			if err != nil {
+				findings = append(findings, toolboxFinding(CommandAIReportGallery, "AI-REPORT-GALLERY-SAMPLE-SKIPPED", resultmodel.SeverityWarning,
+					[]string{record}, fmt.Sprintf("skipped sample %s: %v", name, err), resultmodel.FixabilityManual, ""))
+				continue
+			}
+			byName[name] = sample
+		}
+	}
+	samples := make([]reportGallerySample, 0, len(byName))
+	for _, sample := range byName {
+		samples = append(samples, sample)
+	}
+	sort.Slice(samples, func(left, right int) bool { return samples[left].Name < samples[right].Name })
+	return samples, findings, nil
+}
+
+func readReportGallerySample(repository *os.Root, name, record string) (reportGallerySample, error) {
+	sample := reportGallerySample{Name: name, RecordPath: record}
+	filename := filepath.FromSlash(record)
+	info, err := repository.Lstat(filename)
+	if err != nil {
+		return sample, err
+	}
+	if !info.Mode().IsRegular() {
+		return sample, errors.New("sample.md must be a regular file")
+	}
+	content, err := rootedfs.ReadFile(repository, filename)
+	if err != nil {
+		return sample, err
+	}
+	document, err := requestmodel.ParseDocument(content)
+	if err != nil {
+		return sample, err
+	}
+	if warnings := document.ParseWarnings(); len(warnings) != 0 {
+		return sample, errors.New(warnings[0])
+	}
+	var added string
+	for _, field := range []struct {
+		name  string
+		value *string
+	}{
+		{"title", &sample.Title}, {"use_when", &sample.UseWhen}, {"source", &sample.Source}, {"added", &added}, {"image", &sample.Image},
+	} {
+		evidence, present := document.FieldValue(field.name)
+		if !present && field.name == "image" {
+			continue
+		}
+		value := strings.TrimSpace(evidence.ScalarValue)
+		raw := evidence.RawValue
+		quoted := strings.HasPrefix(raw, `"`) || strings.HasPrefix(raw, "'")
+		if value == "" || (quoted && evidence.ScalarValue == raw) || evidence.ListValues != nil || strings.HasPrefix(raw, "{") ||
+			strings.IndexFunc(value, unicode.IsControl) >= 0 {
+			return sample, fmt.Errorf("%s must be a nonempty one-line scalar", field.name)
+		}
+		*field.value = value
+	}
+	if _, err := time.Parse(time.DateOnly, added); err != nil {
+		return sample, errors.New("added must be a valid YYYY-MM-DD date")
+	}
+	if sample.Image != "" && (!fs.ValidPath(sample.Image) || sample.Image == "." || strings.ContainsAny(sample.Image, `\:`)) {
+		return sample, errors.New("image must be a path relative to the sample folder")
+	}
+	sample.Borrow, err = readReportGalleryBorrow(document.BodyBytes())
+	return sample, err
+}
+
+func readReportGalleryBorrow(body []byte) ([]string, error) {
+	var bullets []string
+	for _, section := range requestmodel.VisibleSections(body) {
+		if section.Name != "Borrow" || section.HeadingIndent != 0 {
+			continue
+		}
+		if bullets != nil {
+			return nil, errors.New("sample has more than one ## Borrow section")
+		}
+		bullets = []string{}
+		_, remainder, _ := strings.Cut(string(body[section.Start:section.End]), "\n")
+		for _, line := range strings.Split(remainder, "\n") {
+			line = strings.TrimSpace(line)
+			if line == "" {
+				continue
+			}
+			if len(line) < 3 || !strings.ContainsRune("-*+", rune(line[0])) || line[1] != ' ' {
+				return nil, errors.New("## Borrow must contain only Markdown bullets")
+			}
+			bullets = append(bullets, strings.TrimSpace(line[2:]))
+		}
+	}
+	if len(bullets) < 2 || len(bullets) > 3 {
+		return nil, errors.New("## Borrow must contain two or three Markdown bullets")
+	}
+	return bullets, nil
+}
+
+func writeReportGallery(repositoryRoot string, repository *os.Root, toolboxDocs string, samples []reportGallerySample) resultmodel.CommandResult {
+	info, err := repository.Lstat(filepath.FromSlash(reportGalleryPageFile))
+	exists := err == nil
+	if exists && !info.Mode().IsRegular() {
+		return reportGalleryRefusal(errors.New("the output is not a regular file"))
+	}
+	if err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return reportGalleryFailure(reportGalleryPageFile, err)
+	}
+
+	bundles, _, err := reportIndexWalk(repositoryRoot)
+	if err != nil {
+		return reportGalleryFailure(reportsFolder, err)
+	}
+	page, err := renderReportGalleryPage(repositoryRoot, repository, toolboxDocs, samples, bundles)
+	if err != nil {
+		return reportGalleryFailure(reportGalleryPageFile, err)
+	}
+	if !exists {
+		if err := rootedMkdirAll(repositoryRoot, reportGalleryFolder, 0o755); err != nil {
+			return reportGalleryFailure(reportGalleryPageFile, err)
+		}
+	}
+	checkGenerator := func(original []byte) error {
+		if !bytes.HasPrefix(original, []byte(reportGalleryPageHeader)) {
+			return errHandMadeGallery
+		}
+		return nil
+	}
+	if err := rootedPublishFileChecked(repositoryRoot, reportGalleryPageFile, page, 0o644, exists, checkGenerator); err != nil {
+		if errors.Is(err, errHandMadeGallery) {
+			return reportGalleryRefusal(err)
+		}
+		return reportGalleryFailure(reportGalleryPageFile, err)
+	}
+	kind := "created"
+	if exists {
+		kind = "modified"
+	}
+	return exactOutputResult(reportGalleryPageFile+"\n", []resultmodel.RecordedChange{
+		{Path: reportGalleryPageFile, Kind: kind, Detail: "regenerated derived report gallery"},
+	})
+}
+
+func reportGalleryRefusal(err error) resultmodel.CommandResult {
+	return resultmodel.CommandResult{Outcome: resultmodel.OutcomeRefused, Findings: []resultmodel.CommandFinding{
+		toolboxFinding(CommandAIReportGallery, "AI-REPORT-GALLERY-OUTPUT-REFUSED", resultmodel.SeverityError,
+			[]string{reportGalleryPageFile}, fmt.Sprintf("refusing to replace %s: %v", reportGalleryPageFile, err),
+			resultmodel.FixabilityManual, "the gallery can only replace its own generated page at this path"),
+	}}
+}
+
+func reportGalleryFailure(relative string, err error) resultmodel.CommandResult {
+	return resultmodel.CommandResult{Outcome: resultmodel.OutcomeFailure, Findings: []resultmodel.CommandFinding{
+		toolboxFinding(CommandAIReportGallery, "AI-REPORT-GALLERY-FAILED", resultmodel.SeverityError, []string{relative},
+			err.Error(), resultmodel.FixabilityManual, "the report gallery could not be read or written"),
+	}}
+}
diff -ruN /Users/t2/Desktop/e1-experimental-repos/skill-do-work2/do-work/runs/work-2026-11-18-153357/.consumer.W4kn0n/project/.claude/skills/do-work/tools/do-work-cli/internal/toolboxcommands/report_gallery_page.go /var/folders/2w/kw8sv6rd1z15yjykl787ryph0000gn/T/do-work-update.1485964156/fresh/skills/do-work/tools/do-work-cli/internal/toolboxcommands/report_gallery_page.go
--- /Users/t2/Desktop/e1-experimental-repos/skill-do-work2/do-work/runs/work-2026-11-18-153357/.consumer.W4kn0n/project/.claude/skills/do-work/tools/do-work-cli/internal/toolboxcommands/report_gallery_page.go	1970-01-01 02:00:00
+++ /var/folders/2w/kw8sv6rd1z15yjykl787ryph0000gn/T/do-work-update.1485964156/fresh/skills/do-work/tools/do-work-cli/internal/toolboxcommands/report_gallery_page.go	2026-11-18 17:52:00
@@ -0,0 +1,283 @@
+package toolboxcommands
+
+import (
+	"bytes"
+	"errors"
+	"html/template"
+	"io/fs"
+	"net/url"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+type reportGalleryLink struct {
+	Label string
+	Href  string
+}
+
+type reportGalleryCard struct {
+	Title   string
+	UseWhen string
+	Borrow  []string
+	Links   []reportGalleryLink
+}
+
+type reportGalleryKind struct {
+	Label   string
+	Command string
+	Latest  reportGalleryLink
+}
+
+type reportGalleryPageData struct {
+	Stylesheet string
+	Samples    []reportGalleryCard
+	Kinds      []reportGalleryKind
+	Presets    []reportGalleryLink
+}
+
+func renderReportGalleryPage(repositoryRoot string, repository *os.Root, toolboxDocs string, samples []reportGallerySample, bundles []reportBundle) ([]byte, error) {
+	page := reportGalleryPageData{Kinds: reportGalleryKinds(bundles)}
+	if toolboxDocs != "" {
+		stylesheet := path.Join(toolboxDocs, "ai-report-kit", "presentation.css")
+		page.Stylesheet = reportGalleryFileLink(repository, stylesheet)
+		var err error
+		page.Presets, err = reportGalleryPresets(repository, path.Join(toolboxDocs, secondOpinionPresetsFolder))
+		if err != nil {
+			return nil, err
+		}
+	}
+	for _, sample := range samples {
+		card := reportGalleryCard{Title: sample.Title, UseWhen: sample.UseWhen, Borrow: sample.Borrow}
+		folder := path.Dir(sample.RecordPath)
+		if href := reportGalleryFileLink(repository, path.Join(folder, reportGalleryExample)); href != "" {
+			card.Links = append(card.Links, reportGalleryLink{"Worked example", href})
+		}
+		if sample.Image != "" {
+			if href := reportGalleryFileLink(repository, path.Join(folder, sample.Image)); href != "" {
+				card.Links = append(card.Links, reportGalleryLink{"Reference image", href})
+			}
+		}
+		if len(card.Links) == 0 {
+			if href := reportGallerySourceLink(repositoryRoot, repository, sample.Source); href != "" {
+				card.Links = append(card.Links, reportGalleryLink{"Source", href})
+			}
+		}
+		card.Links = append(card.Links, reportGalleryLink{"Sample record", reportGalleryHref(sample.RecordPath)})
+		page.Samples = append(page.Samples, card)
+	}
+	var output bytes.Buffer
+	if err := reportGalleryPageTemplate.Execute(&output, page); err != nil {
+		return nil, err
+	}
+	return output.Bytes(), nil
+}
+
+func reportGalleryKinds(bundles []reportBundle) []reportGalleryKind {
+	latest := map[string]reportGalleryLink{}
+	for _, bundle := range bundles { // The catalog walk has already sorted newest first.
+		if bundle.Entry == "" {
+			continue
+		}
+		kind := bundle.Kind
+		if kind == "unknown" {
+			kind = "completed-work" // Pre-kind reports and the default ai-report form have no kind meta.
+		}
+		if _, found := latest[kind]; !found {
+			latest[kind] = reportGalleryLink{bundle.Title, reportGalleryHref(bundle.Entry)}
+		}
+	}
+	// These are the report-producing routes with a creation command. The
+	// catalog also accepts custom kind metadata, which is included when present.
+	var kinds []reportGalleryKind
+	for _, kind := range []struct{ name, label, command string }{
+		{"completed-work", "Completed work", "do-work-toolbox ai-report <REQ-NNN | UR-NNN>"},
+		{"proposal", "Proposal", "do-work-toolbox ai-report --kind proposal <topic | REQ-NNN | UR-NNN>"},
+		{"root-cause", "Root cause", "do-work-toolbox ai-report --kind root-cause <topic | REQ-NNN | UR-NNN>"},
+		{"architecture-report", "Architecture report", "do-work-toolbox architecture-report"},
+	} {
+		kinds = append(kinds, reportGalleryKind{Label: kind.label, Command: kind.command, Latest: latest[kind.name]})
+		delete(latest, kind.name)
+	}
+	extraNames := make([]string, 0, len(latest))
+	for name := range latest {
+		extraNames = append(extraNames, name)
+	}
+	sort.Strings(extraNames)
+	for _, name := range extraNames {
+		kinds = append(kinds, reportGalleryKind{Label: name, Latest: latest[name]})
+	}
+	return kinds
+}
+
+func reportGalleryPresets(repository *os.Root, folder string) ([]reportGalleryLink, error) {
+	entries, err := fs.ReadDir(repository.FS(), folder)
+	if errors.Is(err, fs.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var links []reportGalleryLink
+	for _, entry := range entries {
+		name, markdown := strings.CutSuffix(entry.Name(), ".md")
+		if entry.Type().IsRegular() && markdown && name != "" && !strings.HasPrefix(name, ".") {
+			links = append(links, reportGalleryLink{name, reportGalleryHref(path.Join(folder, entry.Name()))})
+		}
+	}
+	return links, nil
+}
+
+func reportGallerySourceLink(repositoryRoot string, repository *os.Root, source string) string {
+	if source == "shipped" {
+		return ""
+	}
+	filename := filepath.FromSlash(source)
+	if filepath.IsAbs(filename) {
+		relative, err := filepath.Rel(repositoryRoot, filename)
+		if err != nil {
+			return ""
+		}
+		if !filepath.IsLocal(relative) {
+			// Keep an explicitly supplied absolute source usable from disk
+			// without reading files outside the repository.
+			return reportGalleryHref(filepath.ToSlash(relative))
+		}
+		filename = relative
+	} else if reference, err := url.Parse(source); err == nil && reference.Scheme != "" {
+		if (reference.Scheme == "https" || reference.Scheme == "http") && reference.Host != "" {
+			return reference.String()
+		}
+		return ""
+	}
+	relative := filepath.ToSlash(filepath.Clean(filename))
+	if !fs.ValidPath(relative) || relative == "." {
+		return ""
+	}
+	return reportGalleryFileLink(repository, relative)
+}
+
+func reportGalleryFileLink(repository *os.Root, relative string) string {
+	info, err := repository.Lstat(filepath.FromSlash(relative))
+	if err != nil || !info.Mode().IsRegular() {
+		return ""
+	}
+	return reportGalleryHref(relative)
+}
+
+func reportGalleryHref(target string) string {
+	relative, err := filepath.Rel(filepath.FromSlash(reportGalleryFolder), filepath.FromSlash(target))
+	if err != nil {
+		return ""
+	}
+	return (&url.URL{Path: filepath.ToSlash(relative)}).String()
+}
+
+// The exact header puts the ownership marker in an actual meta element.
+const reportGalleryPageHeader = `<!doctype html>
+<html lang="en">
+<head>
+<meta name="generator" content="do-work-cli ai-report-gallery">
+`
+
+var reportGalleryPageTemplate = template.Must(template.New("report-gallery").Parse(reportGalleryPageHeader + `<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>AI Report Gallery</title>
+{{if .Stylesheet}}<link rel="stylesheet" href="{{.Stylesheet}}">{{end}}
+<style>
+html { color-scheme: light dark; }
+.gallery { max-width: 72rem; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 3rem) 4rem; }
+.gallery .band { padding: 2rem 0; }
+.gallery-header { padding: 3rem 0 1rem; }
+.gallery-links { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
+.gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: 1rem; }
+.gallery-card { display: flex; flex-direction: column; }
+.gallery-card ul { margin: .25rem 0 1rem; padding-inline-start: 1.25em; }
+.gallery-card .gallery-links { margin: auto 0 0; font-size: .95rem; }
+.gallery-kinds { list-style: none; margin: 0; padding: 0; }
+.gallery-kinds li { display: grid; grid-template-columns: minmax(9rem, 13rem) 1fr; gap: .25rem 1rem; padding: .65rem 0; border-bottom: 1px solid var(--line, GrayText); }
+.gallery-presets { list-style: none; padding: 0; }
+.gallery-copy { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; }
+.gallery-copy code { padding: .35em .5em; overflow-wrap: anywhere; }
+.gallery-copy button[hidden] { display: none; }
+@media (max-width: 40rem) { .gallery-kinds li { grid-template-columns: 1fr; } }
+</style>
+</head>
+<body>
+<main class="gallery">
+  <header class="gallery-header">
+    <h1>AI Report Gallery</h1>
+    <nav class="gallery-links" aria-label="Gallery sections">
+      <a href="#samples">Samples</a>
+      <a href="#report-kinds">Report kinds</a>
+      <a href="#presets">Second-opinion presets</a>
+      <a href="#add-sample">Add a sample</a>
+    </nav>
+  </header>
+  <section class="band" id="samples" aria-labelledby="samples-title">
+    <h2 id="samples-title">Samples</h2>
+    {{if .Samples}}<div class="gallery-grid">
+      {{range .Samples}}<article class="node gallery-card">
+        <h3>{{.Title}}</h3>
+        <p>{{.UseWhen}}</p>
+        <strong>Borrow</strong>
+        <ul>{{range .Borrow}}<li>{{.}}</li>{{end}}</ul>
+        <p class="gallery-links">{{range .Links}}<a href="{{.Href}}">{{.Label}}</a>{{end}}</p>
+      </article>{{end}}
+    </div>{{else}}<p>No samples yet.</p>{{end}}
+  </section>
+  <section class="band" id="report-kinds" aria-labelledby="report-kinds-title">
+    <h2 id="report-kinds-title">Report kinds</h2>
+    <ul class="gallery-kinds">
+      {{range .Kinds}}<li><strong>{{.Label}}</strong>
+        {{if .Latest.Href}}<a href="{{.Latest.Href}}">{{.Latest.Label}}</a>{{else}}<span>Create one with <code>{{.Command}}</code></span>{{end}}
+      </li>{{end}}
+    </ul>
+  </section>
+  <section class="band" id="presets" aria-labelledby="presets-title">
+    <h2 id="presets-title">Second-opinion presets</h2>
+    {{if .Presets}}<ul class="gallery-links gallery-presets">
+      {{range .Presets}}<li><a href="{{.Href}}">{{.Label}}</a></li>{{end}}
+    </ul>{{else}}<p>No shipped presets found.</p>{{end}}
+  </section>
+  <section class="band" id="add-sample" aria-labelledby="add-sample-title">
+    <h2 id="add-sample-title">Add a sample</h2>
+    <p>Paste this line into your agent, replacing the placeholders with the source and what you liked.</p>
+    <div class="gallery-copy">
+      <code id="add-line">do-work-toolbox ai-report gallery add &lt;image path | link | html path&gt; [what the user liked]</code>
+      <button class="btn" id="copy-add-line" type="button" hidden>Copy command</button>
+      <span id="copy-status" role="status"></span>
+    </div>
+  </section>
+</main>
+<script>
+const addLine = document.getElementById('add-line');
+const copyButton = document.getElementById('copy-add-line');
+const copyStatus = document.getElementById('copy-status');
+copyButton.hidden = false;
+copyButton.addEventListener('click', async () => {
+  if (location.protocol !== 'file:' && navigator.clipboard) {
+    try {
+      await navigator.clipboard.writeText(addLine.textContent);
+      copyStatus.textContent = 'Copied.';
+      return;
+    } catch {
+      // Select the visible command for browsers that deny clipboard access.
+    }
+  }
+  const range = document.createRange();
+  range.selectNodeContents(addLine);
+  const selection = window.getSelection();
+  selection.removeAllRanges();
+  selection.addRange(range);
+  let copied = false;
+  try { copied = document.execCommand('copy'); } catch {}
+  if (copied) selection.removeAllRanges();
+  copyStatus.textContent = copied ? 'Copied.' : 'Command selected. Use your keyboard to copy.';
+});
+</script>
+</body>
+</html>
