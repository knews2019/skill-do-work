+// REQ-598: rollbackFailure records a failed os.OpenRoot and keeps going, so a failed
+// transaction still unstages its paths and still reports. quarantineAndRollbackPrivate took
+// that nil handle without a check and dereferenced it at root.Mkdir, so a transaction with an
+// identity-recorded private target panicked mid-rollback and lost its own report. This is the
+// package's first test through a no-handle rollback. The worktree root is renamed away after
+// the last successful open, so the rollback open is the only one that fails. ENOENT needs no
+// privileges; an execute-only root would need a non-root test process, since uid 0 opens it
+// regardless.
+func TestRollbackWithoutRootHandleReportsPrivateTargetLeftAsPublished(t *testing.T) {
+	repositoryRoot := newRepository(t)
+	privatePath := "memory/logs/created.md"
+	if err := os.MkdirAll(filepath.Join(repositoryRoot, "memory", "logs"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	renamedRoot := repositoryRoot + "-renamed-away"
+	result := ExecuteTransaction(context.Background(), TransactionOptions{
+		RepositoryRoot:              repositoryRoot,
+		TargetPaths:                 []string{privatePath},
+		PrivateUntrackedTargetPaths: []string{privatePath},
+	}, func(recorder *MutationRecorder) error {
+		if err := recorder.RecordCreated(privatePath); err != nil {
+			return err
+		}
+		if err := os.WriteFile(filepath.Join(repositoryRoot, filepath.FromSlash(privatePath)), []byte("ours\n"), 0o600); err != nil {
+			return err
+		}
+		if err := recorder.RecordPublished(privatePath); err != nil {
+			return err
+		}
+		if err := os.Rename(repositoryRoot, renamedRoot); err != nil {
+			return err
+		}
+		return errors.New("force rollback")
+	})
+	if err := os.Rename(renamedRoot, repositoryRoot); err != nil {
+		t.Fatal(err)
+	}
+	if result.Outcome != resultmodel.OutcomeRisk || result.Rollback.Status != resultmodel.RollbackIncomplete || result.Failure == nil || result.Failure.Kind != FailureRollback {
+		t.Fatalf("no-handle rollback = %#v", result)
+	}
+	openFailureReported, unusableHandleReported := false, false
+	for _, line := range result.Rollback.Errors {
+		if strings.HasPrefix(line, "open rollback root: ") {
+			openFailureReported = true
+		}
+		if strings.Contains(line, "rollback root is unavailable") && strings.Contains(line, privatePath) {
+			unusableHandleReported = true
+		}
+	}
+	if !openFailureReported || !unusableHandleReported {
+		t.Fatalf("no-handle rollback errors = %q", result.Rollback.Errors)
+	}
+	if got := readFile(t, repositoryRoot, privatePath); got != "ours\n" {
+		t.Fatalf("private bytes after no-handle rollback = %q", got)
+	}
+	entries, err := os.ReadDir(repositoryRoot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		if strings.HasPrefix(entry.Name(), ".do-work-private-rollback-") {
+			t.Fatalf("quarantine directory created without a rollback root: %s", entry.Name())
+		}
+	}
+}
